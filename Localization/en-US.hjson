Mods: {
	DemonSlayerMod: {
		Items: {
			WoodenCharm: {
				DisplayName: Wooden Charm
				Tooltip:
					'''
					Summons Mukago, Lower Moon Four
					Only works at night, after the Eye of Cthulhu has been defeated
					'''
			}

			TsuzumiDrum: {
				DisplayName: Tsuzumi Drum
				Tooltip:
					'''
					Summons Kyogai, the former Lower Moon Six
					Only works at night, after the Eater of Worlds or Brain of Cthulhu has been defeated
					'''
			}

			CrackedMagatama: {
				DisplayName: Cracked Magatama
				Tooltip:
					'''
					Summons Kaigaku, the new Upper Moon Six
					Only works at night, after all three mechanical bosses have been defeated
					'''
			}

			BiwaString: {
				DisplayName: Biwa String
				Tooltip:
					'''
					Summons Nakime, the new Upper Moon Four
					Only works at night, after Golem has been defeated
					'''
			}

			CorpsUniform: {
				DisplayName: Corps Uniform
				Tooltip:
					'''
					+20 max Breath
					"Woven from special fibres that shrug off lesser demons' claws"
					'''
			}

			WaterHaori: {
				DisplayName: Two-Pattern Haori
				Tooltip:
					'''
					+25% Breath regeneration
					6% increased melee speed
					'''
			}

			FlameHaori: {
				DisplayName: Flame Haori
				Tooltip:
					'''
					8% increased melee damage
					Immunity to On Fire! and Burning
					'''
			}

			ButterflyHaori: {
				DisplayName: Butterfly Haori
				Tooltip:
					'''
					10% increased movement speed
					8% increased melee critical strike chance
					'''
			}

			CheckeredHaori: {
				DisplayName: Checkered Haori
				Tooltip: +10% breathing technique damage
			}

			HanafudaEarrings: {
				DisplayName: Hanafuda Earrings
				Tooltip:
					'''
					+25% Breath regeneration
					+20% technique damage with Sun Breathing
					'''
			}

			WisteriaCharm: {
				DisplayName: Wisteria Charm
				Tooltip: Demons and their attacks deal 20% less damage to you
			}

			WisteriaPoison: {
				DisplayName: Wisteria Poison
				Tooltip:
					'''
					Coats your blade with wisteria poison
					Blade and technique hits inflict Venom and deal 10% more damage to demons
					'''
			}

			ButterflyMedicine: {
				DisplayName: Butterfly Mansion Medicine
				Tooltip: A remedy from the Butterfly Mansion
			}

			CrowWhistle: {
				DisplayName: Crow Whistle
				Tooltip:
					'''
					Summons a Kasugai Crow
					It caws when demons are near
					'''
			}

			NichirinBlade: {
				DisplayName: Nichirin Blade
				Tooltip:
					'''
					A Demon Slayer's sword, forged from steel that drinks in the sun
					Demons take full damage only from Nichirin steel and breathing techniques
					Right-click a Swordsmith's Forge to change its steel, shape, colour, guard, wrap, engraving and trail
					'''
			}

			DemonBlood: {
				DisplayName: Demon Blood
				Tooltip:
					'''
					It's still warm...
					Used to make lures that draw out powerful demons
					'''
			}

			TrainingScroll: {
				DisplayName: Training Scroll
				Tooltip:
					'''
					Grants 1 extra stat point
					You can use up to 20
					'''
			}

			ScrollOfForgetting: {
				DisplayName: Scroll of Forgetting
				Tooltip: Refunds all your stat points so you can spend them again
			}

			SwordsmithForge: {
				DisplayName: Swordsmith's Forge
				Tooltip:
					'''
					Right-click it to customise your Nichirin Blade
					Used to forge Nichirin Blades
					'''
			}

			SelectionTag: {
				DisplayName: Final Selection Tag
				Tooltip:
					'''
					Summons the Hand Demon
					Only works at night
					'''
			}

			SpiderSilkDoll: {
				DisplayName: Spider Silk Doll
				Tooltip:
					'''
					Summons Rui, Lower Moon Five
					Only works at night, after the Eye of Cthulhu has been defeated
					'''
			}

			TrainTicket: {
				DisplayName: Infinity Train Ticket
				Tooltip:
					'''
					Summons Enmu, Lower Moon One
					Only works at night, after Skeletron has been defeated
					'''
			}

			DistrictObi: {
				DisplayName: Entertainment District Obi
				Tooltip:
					'''
					Summons Gyutaro and Daki, Upper Moon Six
					Only works at night, in Hardmode
					'''
			}

			CrackedVase: {
				DisplayName: Cracked Vase
				Tooltip:
					'''
					Summons Gyokko, Upper Moon Five
					Only works at night, after a mechanical boss has been defeated
					'''
			}

			LeafFan: {
				DisplayName: Leaf Fan
				Tooltip:
					'''
					Summons Hantengu, Upper Moon Four
					Only works at night, after all three mechanical bosses have been defeated
					'''
			}

			MartialBeads: {
				DisplayName: Martial Artist's Beads
				Tooltip:
					'''
					Summons Akaza, Upper Moon Three
					Only works at night, after Plantera has been defeated
					'''
			}

			GoldenFan: {
				DisplayName: Golden Fan
				Tooltip:
					'''
					Summons Doma, Upper Moon Two
					Only works at night, after Golem has been defeated
					'''
			}

			BrokenFlute: {
				DisplayName: Broken Flute
				Tooltip:
					'''
					Summons Kokushibo, Upper Moon One
					Only works at night, after the Lunatic Cultist has been defeated
					'''
			}

			BlueSpiderLily: {
				DisplayName: Blue Spider Lily
				Tooltip:
					'''
					Summons Muzan Kibutsuji, the Demon King
					Only works at night, after the Moon Lord has been defeated
					'''
			}
		}

