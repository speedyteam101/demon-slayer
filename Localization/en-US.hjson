		Buffs: {
			DemonFormBuff: {
				DisplayName: Demon Form
				Description: Muzan's blood burns in your veins. Monstrous strength, speed and regeneration. Ends at dawn
			}
			WisteriaPoisonBuff: {
				DisplayName: Wisteria Poison
				Description: Blade and technique hits inflict Venom and deal 10% more damage to demons
			}
			KasugaiCrowBuff: {
				DisplayName: Kasugai Crow
				Description: A crow is keeping watch for demons
			}
			DeadCalmBuff: {
				DisplayName: Dead Calm
				Description: +25 defense, 15% less damage taken, immune to knockback
			}
			SensesBuff: {
				DisplayName: Heightened Senses
				Description: +20% crit chance; you sense enemies and danger
			}
			AfterimageBuff: {
				DisplayName: Afterimage
				Description: 25% chance to dodge attacks, +20% movement speed
			}
			DemonSlayerMarkBuff: {
				DisplayName: Demon Slayer Mark
				Description: +25% damage, +20% melee speed, +25% movement speed, 10% less damage taken, fast regeneration
			}
